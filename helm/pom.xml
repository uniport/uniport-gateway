<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.uniport.gateway</groupId>
        <artifactId>reactor</artifactId>
        <version>10.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>helm</artifactId>
    <packaging>helm</packaging>

    <properties>
        <chart.directory>${project.build.directory}/uniport-gateway</chart.directory>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ch.uniport.gateway</groupId>
            <artifactId>config-schemas</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>with-substitution</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <outputDirectory>${chart.directory}</outputDirectory>
                            <nonFilteredFileExtensions>
                                <nonFilteredFileExtension>tgz</nonFilteredFileExtension>
                            </nonFilteredFileExtensions>
                            <resources>
                                <resource>
                                    <directory>src/main/resources</directory>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-config-schemas</id>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>ch.uniport.gateway</groupId>
                                    <artifactId>config-schemas</artifactId>
                                    <type>jar</type>
                                    <includes>schema/*.json</includes>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Download chart dependencies into src/main/resources/charts/ only when not
                             already cached; maven-resources-plugin then copies them to target/.
                             The portal-lib version is read from Chart.yaml (single source of truth). -->
                        <id>ensure-chart-dependencies</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <executable>bash</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>VERSION=$(grep -A3 'name: portal-lib' src/main/resources/Chart.yaml | grep 'version:' | tr -d '"' | awk '{print $2}')
                                    if [ ! -f "src/main/resources/charts/portal-lib-${VERSION}.tgz" ]; then
                                      echo "[helm] Chart dependency not cached, downloading via helm dependency build...";
                                      helm dependency build src/main/resources;
                                    else
                                      echo "[helm] Using cached chart dependency (src/main/resources/charts/).";
                                    fi</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-static-config</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>verify</phase>
                        <configuration>
                            <executable>./validate-configs.sh</executable>
                        </configuration>
                    </execution>
                    <execution>
                        <id>unpack-value-schema-json</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <!-- has to run after helm:lint (bound to process-resources) -->
                        <phase>process-test-resources</phase>
                        <configuration>
                            <executable>bash</executable>
                            <workingDirectory>${chart.directory}</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>VERSION=$(grep -A3 'name: portal-lib' Chart.yaml | grep 'version:' | tr -d '"' | awk '{print $2}')
tar --extract --verbose --file "charts/portal-lib-${VERSION}.tgz" --strip-components 1 portal-lib/values.schema.json</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>io.kokuwa.maven</groupId>
                <artifactId>helm-maven-plugin</artifactId>
                <configuration>
                    <chartDirectory>${chart.directory}</chartDirectory>
                    <excludes>
                        <exclude>${chart.directory}/charts/**/charts/portal-lib</exclude>
                    </excludes>
                    <!-- Chart dependency resolution is owned by the ensure-chart-dependencies exec
                         below, which keeps the tarball in src/main/resources/charts (gitignored);
                         maven-resources-plugin copies it to target -->
                    <skipDependencyBuild>true</skipDependencyBuild>
                    <skipDependencyUpdate>true</skipDependencyUpdate>
                </configuration>
                <executions>
                    <execution>
                        <id>default-lint</id>
                        <configuration>
                            <values>
                                <yamlFiles>
                                    <yamlFiles>${chart.directory}/values.localdev.yaml</yamlFiles>
                                </yamlFiles>
                            </values>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
